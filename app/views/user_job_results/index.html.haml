- title t(".title")
- @user_job_results.each do |user_job_result|
  .container-fluid.text-center.bg-light.m-2.p-3
    .row
      .col-1
        = job_status_icon(user_job_result.status.to_sym)
      .col-3
        = user_job_result.name
      .col-3
        = job_progress_bar(user_job_result.progress)
      .col-3
        = "#{t('.start_timestamp')}: #{job_timestamp(user_job_result.start_timestamp)}"
        %br
        = "#{t('.end_timestamp')}: #{job_timestamp(user_job_result.end_timestamp)}"
      .col-1
        = "#{t('.attempts')}: #{user_job_result.attempts}/#{Delayed::Worker.max_attempts}"
      .col-1
        - if user_job_result.downloadable?(current_person)
          = link_to(icon("download", {filled: true}), "/downloads/#{user_job_result.id}")
